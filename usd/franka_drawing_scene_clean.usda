#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        bool physxScene:enableStabilization = 0
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 60
    }

    def Scope "Lights"
    {
        def DomeLight "AmbientDome"
        {
            color3f inputs:color = (1, 1, 1)
            float inputs:intensity = 250
        }

        def RectLight "OverheadSoftbox"
        {
            color3f inputs:color = (1, 1, 1)
            float inputs:height = 1
            float inputs:intensity = 650
            float inputs:width = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.5, 0, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def DistantLight "KeyLight"
        {
            float inputs:angle = 0.5
            color3f inputs:color = (1, 1, 1)
            float inputs:intensity = 350
            quatd xformOp:orient = (0.9238795325, 0.3826834324, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:orient"]
        }

        def RectLight "FrontFill"
        {
            color3f inputs:color = (1, 1, 1)
            float inputs:height = 0.6
            float inputs:intensity = 180
            float inputs:width = 0.8
            quatd xformOp:orient = (0.9238795325, 0.3826834324, 0, 0)
            double3 xformOp:translate = (0.15, -0.75, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def Xform "Franka" (
        prepend references = @assets/franka/franka_panda.usd@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        over "panda_leftfinger"
        {
            token visibility = "invisible"

            over "visuals"
            {
                token visibility = "invisible"
            }

            over "collisions" (
                active = false
            )
            {
            }
        }

        over "panda_rightfinger"
        {
            token visibility = "invisible"

            over "visuals"
            {
                token visibility = "invisible"
            }

            over "collisions" (
                active = false
            )
            {
            }
        }

        over "panda_link7"
        {
            over "panda_link8"
            {
                over "panda_hand"
                {
                    def Xform "PenTool"
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                        def Cylinder "PenBody" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                        )
                        {
                            token axis = "Z"
                            double height = 0.094
                            rel material:binding = </World/PhysicsMaterials/PenTipMaterial>
                            color3f[] primvars:displayColor = [(0.02, 0.02, 0.02)]
                            uniform token primvars:displayColor:interpolation = "constant"
                            double radius = 0.005
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0.047)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }

                        def Sphere "PenTip" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </World/PhysicsMaterials/PenTipMaterial>
                            color3f[] primvars:displayColor = [(0.9, 0.05, 0.05)]
                            uniform token primvars:displayColor:interpolation = "constant"
                            double radius = 0.003
                            double3 xformOp:translate = (0, 0, 0.097)
                            uniform token[] xformOpOrder = ["xformOp:translate"]
                        }

                        def Xform "PenTipFrame"
                        {
                            quatd xformOp:orient = (1, 0, 0, 0)
                            double3 xformOp:translate = (0, 0, 0.1)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                        }
                    }
                }
            }
        }
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/PhysicsMaterials/TableMaterial>
        color3f[] primvars:displayColor = [(0.45, 0.32, 0.2)]
        uniform token primvars:displayColor:interpolation = "constant"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (0.3, 0.3, 0.05)
        double3 xformOp:translate = (0.5, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "Paper" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/PhysicsMaterials/PaperMaterial>
        color3f[] primvars:displayColor = [(1, 1, 0.96)]
        uniform token primvars:displayColor:interpolation = "constant"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (0.15, 0.15, 0.001)
        double3 xformOp:translate = (0.5, 0, 0.201)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "BoardFrame"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.5, 0, 0.202)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Scope "PhysicsMaterials"
    {
        def Material "PaperMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.12
            float physics:restitution = 0
            float physics:staticFriction = 0.18
        }

        def Material "PenTipMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.05
            float physics:restitution = 0
            float physics:staticFriction = 0.08
        }

        def Material "TableMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }
    }
}
